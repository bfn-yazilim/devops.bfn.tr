@model CreateUserViewModel
@{ ViewData["Title"] = "Yeni Kullanıcı"; }
<div class="mx-auto max-w-xl">
    <form method="post" class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title">Yeni kullanıcı</h2>
            <div asp-validation-summary="ModelOnly"></div>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Kullanıcı adı</legend>
                <input asp-for="UserName" class="input w-full" />
            </fieldset>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Geçici parola</legend>
                <input asp-for="Password" class="input w-full" />
            </fieldset>
            <label class="label cursor-pointer justify-start gap-3 py-3"><input asp-for="IsAdministrator" class="toggle" /><span>Yönetici yetkisi ver</span></label>
            <div class="card-actions justify-end pt-2">
                <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
                <button class="btn btn-primary">Oluştur</button>
            </div>
        </div>
    </form>
</div>
