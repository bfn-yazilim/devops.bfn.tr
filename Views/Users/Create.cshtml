@model CreateUserViewModel
@{ ViewData["Title"] = "Yeni Kullanıcı"; }
<h1 class="h3">Yeni kullanıcı</h1><form method="post" class="col-md-6"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" /></div>
<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /></div>
<div class="form-check mb-3"><input asp-for="IsAdministrator" class="form-check-input" /><label asp-for="IsAdministrator" class="form-check-label"></label></div>
<button class="btn btn-primary">Oluştur</button> <a asp-action="Index" class="btn btn-link">Vazgeç</a></form>
