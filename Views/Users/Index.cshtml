@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Kullanıcılar</h1><a asp-action="Create" class="btn btn-primary">Yeni kullanıcı</a></div>
<table class="table table-hover align-middle"><thead><tr><th>Kullanıcı</th><th>Durum</th><th>Oluşturma</th><th></th></tr></thead><tbody>
@foreach (var user in Model) { <tr><td>@user.UserName @if(user.IsFounder){<span class="badge bg-dark">Kurucu</span>}</td><td>@(user.MustChangePassword ? "Parola değişikliği bekliyor" : "Aktif")</td><td>@user.CreatedAtUtc.ToLocalTime().ToString("g")</td><td class="text-end">@if(!user.IsFounder){<form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Kullanıcı silinsin mi?')"><button class="btn btn-sm btn-outline-danger">Sil</button></form>}</td></tr> }
</tbody></table>
