@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="mb-6 flex items-center justify-between"><div><h2 class="text-2xl font-bold">Kullanıcılar</h2><p class="text-base-content/60">Panel erişimlerini yönetin.</p></div><a asp-action="Create" class="btn btn-primary">+ Yeni kullanıcı</a></div>
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100"><table class="table"><thead><tr><th>Kullanıcı</th><th>Durum</th><th>Oluşturma</th><th></th></tr></thead><tbody>@foreach(var user in Model){<tr><td class="font-medium">@user.UserName @if(user.IsFounder){<span class="badge badge-neutral badge-sm ml-2">Kurucu</span>}</td><td><span class="badge @(user.MustChangePassword ? "badge-warning" : "badge-success")">@(user.MustChangePassword ? "Parola bekleniyor" : "Aktif")</span></td><td>@user.CreatedAtUtc.ToLocalTime().ToString("g")</td><td class="text-right">@if(!user.IsFounder){<form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Kullanıcı silinsin mi?')"><button class="btn btn-ghost btn-sm text-error">Sil</button></form>}</td></tr>}</tbody></table></div>
