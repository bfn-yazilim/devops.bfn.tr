@model ChangePasswordViewModel
@{ ViewData["Title"] = "Parola Değiştir"; }
<div class="mx-auto max-w-xl">
    <div class="alert alert-warning mb-5"><span>İlk girişte güvenli bir parola belirlemeniz zorunludur.</span></div>
    <form method="post" class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title">Parolanızı değiştirin</h2>
            <div asp-validation-summary="ModelOnly"></div>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Mevcut parola</legend>
                <input asp-for="CurrentPassword" class="input w-full" />
            </fieldset>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Yeni parola</legend>
                <input asp-for="NewPassword" class="input w-full" />
                <p class="label">En az 8 karakter; büyük/küçük harf, rakam ve özel karakter.</p>
            </fieldset>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Yeni parola (tekrar)</legend>
                <input asp-for="ConfirmPassword" class="input w-full" />
            </fieldset>
            <button class="btn btn-primary mt-2">Parolayı değiştir</button>
        </div>
    </form>
</div>
