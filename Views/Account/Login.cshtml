@model LoginViewModel
@{ ViewData["Title"] = "Giriş"; }
<div class="grid min-h-screen lg:grid-cols-2"><section class="hidden bg-neutral p-12 text-neutral-content lg:flex lg:flex-col lg:justify-between"><div class="flex items-center gap-3"><span class="grid size-12 place-items-center rounded-xl bg-primary font-black text-primary-content">BFN</span><span class="text-xl font-bold">DevOps</span></div><div class="max-w-xl"><div class="mb-5 badge badge-primary badge-outline">Windows Deployment Center</div><h1 class="text-5xl font-bold leading-tight">Yayın süreçlerinizi tek merkezden yönetin.</h1><p class="mt-5 text-lg text-neutral-content/60">IIS, uygulama havuzları, projeler ve görev panoları güvenli bir çalışma alanında.</p></div><small class="text-neutral-content/40">BFN Yazılım · DevOps Platformu</small></section>
<section class="flex items-center justify-center bg-base-200 p-6"><div class="w-full max-w-md"><div class="mb-8 lg:hidden"><span class="text-2xl font-black text-primary">BFN</span><span class="ml-2 font-bold">DevOps</span></div><div class="card border border-base-300 bg-base-100 shadow-xl"><div class="card-body p-8"><h2 class="text-3xl font-bold">Tekrar hoş geldiniz</h2><p class="text-base-content/60">Devam etmek için hesabınıza giriş yapın.</p><form method="post" class="mt-5"><div asp-validation-summary="ModelOnly"></div><fieldset class="fieldset"><legend class="fieldset-legend">Kullanıcı adı</legend><input asp-for="UserName" class="input w-full" autocomplete="username" autofocus /></fieldset><fieldset class="fieldset"><legend class="fieldset-legend">Parola</legend><input asp-for="Password" class="input w-full" autocomplete="current-password" /></fieldset><button class="btn btn-primary mt-3 w-full">Giriş yap</button></form><div class="divider text-xs">İLK KURULUM</div><p class="text-center text-xs text-base-content/50">İlk giriş: admin / admin · Parolanızı hemen değiştirmeniz istenir.</p></div></div></div></section></div>
