@model DevOpsProject
@{ ViewData["Title"] = "Güncelleme Adımları"; }
@Html.AntiForgeryToken()
<div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-2xl font-bold">@Model.Name</h2><p class="text-base-content/60">Adımları sürükleyerek çalışma sırasını değiştirin.</p></div><div class="flex gap-2"><a asp-action="Edit" asp-route-id="@Model.UId" class="btn btn-ghost">Proje ayarları</a><a asp-action="StepEdit" asp-route-projectId="@Model.UId" class="btn btn-primary">+ Adım ekle</a></div></div>
<div id="steps" data-project-id="@Model.Id" class="space-y-3">
@foreach(var step in Model.DeploymentSteps){<div draggable="true" data-step-id="@step.Id" class="step-item card cursor-grab border border-base-300 bg-base-100 shadow-sm"><div class="card-body flex-row items-center gap-4 p-4"><span class="text-xl text-base-content/30">⠿</span><span class="badge badge-outline">@step.SortOrder</span><div class="min-w-0 flex-1"><strong class="block">@step.Name</strong><span class="text-sm text-base-content/60">@step.Type · @step.TimeoutSeconds sn</span></div>@if(!step.IsEnabled){<span class="badge">Pasif</span>}<a asp-action="StepEdit" asp-route-projectId="@Model.UId" asp-route-id="@step.UId" class="btn btn-ghost btn-sm">Ayarla</a><form asp-action="DeleteStep" asp-route-id="@step.Id" method="post" onsubmit="return confirm('Adım silinsin mi?')"><button class="btn btn-ghost btn-sm text-error">Sil</button></form></div></div>}
</div>
@if(Model.DeploymentSteps.Count==0){<div class="rounded-box border border-dashed border-base-300 bg-base-100 py-14 text-center"><p class="text-base-content/60">Henüz güncelleme adımı eklenmedi.</p></div>}
<div class="alert alert-info mt-6"><span><strong>Kesintisiz yayın önerisi:</strong> Clone → Install → Publish → yeni sürüm dizinine kopyala → Health Check → IIS dizinini değiştir. Eski sürümü geri dönüş için saklayın.</span></div>
@section Scripts { <script>window.setupStepSorting?.();</script> }
