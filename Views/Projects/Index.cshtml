@model IReadOnlyList<DevOpsProject>
@{ ViewData["Title"] = "Projeler"; }
<div class="mb-6 flex items-center justify-between"><div><h2 class="text-2xl font-bold">Projeler</h2><p class="text-base-content/60">Uygulamalarınızı ve yayın akışlarını yönetin.</p></div><a asp-action="Create" class="btn btn-primary">+ Yeni proje</a></div>
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
@foreach(var p in Model){<div class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body"><div class="flex justify-between"><h3 class="card-title">@p.Name</h3><span class="badge @(p.ZeroDowntimeEnabled ? "badge-success" : "badge-ghost")">@(p.ZeroDowntimeEnabled ? "Kesintisiz" : "Standart")</span></div><p class="text-sm text-base-content/60">@(p.Url ?? "URL henüz ayarlanmadı")</p><div class="mt-3 text-sm"><div><span class="text-base-content/50">IIS:</span> @p.IisSiteName</div><div><span class="text-base-content/50">Pool:</span> @p.ApplicationPoolName</div></div><div class="card-actions mt-4 justify-end"><a asp-action="Steps" asp-route-id="@p.Id" class="btn btn-ghost btn-sm">Güncelleme adımları</a><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-primary btn-sm">Düzenle</a></div></div></div>}
@if(Model.Count==0){<div class="hero col-span-full rounded-box border border-dashed border-base-300 bg-base-100 py-16"><div class="text-center"><h3 class="text-xl font-semibold">İlk projenizi oluşturun</h3><p class="my-2 text-base-content/60">IIS ve yayın akışını tek yerden yönetin.</p><a asp-action="Create" class="btn btn-primary mt-3">Proje oluştur</a></div></div>}
</div>
