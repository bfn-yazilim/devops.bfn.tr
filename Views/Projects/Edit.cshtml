@model ProjectEditViewModel
@{ ViewData["Title"] = "Proje Ayarları"; }
<div class="mx-auto max-w-4xl"><div class="mb-5 flex flex-wrap items-center justify-between gap-2"><div><h2 class="text-2xl font-bold">@Model.Name</h2><p class="text-base-content/60">Proje ve IIS hedef ayarları</p></div><div class="flex gap-2"><form asp-action="ApplyIis" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline" onclick="return confirm('Proje ayarları IIS üzerine uygulansın mı?')">IIS'e uygula</button></form><a asp-action="Steps" asp-route-id="@Model.Id" class="btn btn-secondary">Güncelleme adımları →</a></div></div>
<form method="post" class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body grid gap-2 md:grid-cols-2"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="md:col-span-2"></div>
@foreach(var field in new[]{"Name","Url","IisSiteName","ApplicationPoolName","RepositoryUrl","WorkingDirectory"}){<fieldset class="fieldset"><legend class="fieldset-legend">@Html.DisplayName(field)</legend>@Html.TextBox(field, Html.ViewData.Eval(field), new {@class="input w-full"})<span asp-validation-for="@(field)"></span></fieldset>}
<label class="label cursor-pointer justify-start gap-3 py-3 md:col-span-2"><input asp-for="ZeroDowntimeEnabled" class="toggle toggle-success" /><span><strong class="block">Kesintisiz güncelleme</strong><small class="text-base-content/60">Yeni sürümü ayrı dizinde hazırlar, doğrular ve IIS dizinini kontrollü değiştirir.</small></span></label>
<div class="card-actions justify-end pt-2 md:col-span-2"><a asp-action="Index" class="btn btn-ghost">Geri</a><button class="btn btn-primary">Değişiklikleri kaydet</button></div></div></form></div>
