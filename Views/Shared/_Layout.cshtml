@using Bfn.DevOps.Controllers
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentUser = signedIn ? await UserManager.GetUserAsync(User) : null;
    var theme = currentUser?.Theme ?? Context.Request.Cookies[SettingsController.GuestThemeCookie] ?? "bfnorbi";
}
<!DOCTYPE html>
<html lang="tr" data-theme="@theme">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · BFN DevOps</title><link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="bg-base-200 text-base-content">
@if (!signedIn) {
<div class="relative min-h-screen">
    <div class="dropdown dropdown-end absolute right-4 top-4 z-30">
        <button tabindex="0" class="btn btn-square btn-ghost" aria-label="Tema seç" title="Tema seç">
            <span class="grid grid-cols-2 gap-[2px] rounded-md border border-base-300 bg-base-100 p-[5px]">
                <i class="block size-[4px] rounded-full bg-primary"></i><i class="block size-[4px] rounded-full bg-secondary"></i><i class="block size-[4px] rounded-full bg-accent"></i><i class="block size-[4px] rounded-full bg-neutral"></i>
            </span>
        </button>
        <div tabindex="0" class="dropdown-content z-30 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
            <div class="px-3 pb-2 pt-1 text-xs font-semibold text-base-content/50">Tema</div>
            <div class="max-h-96 overflow-y-auto pr-1">
            @foreach (var themeOption in ThemeCatalog.All) {
                <form asp-controller="Settings" asp-action="GuestTheme" method="post">
                    <input type="hidden" name="theme" value="@themeOption.Value" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left text-sm text-base-content hover:bg-base-200">
                        <span data-theme="@themeOption.Value" class="grid aspect-square shrink-0 grid-cols-2 gap-[2px] rounded-md border border-base-300 bg-base-100 p-1"><i class="block aspect-square size-[3px] rounded-full bg-primary"></i><i class="block aspect-square size-[3px] rounded-full bg-secondary"></i><i class="block aspect-square size-[3px] rounded-full bg-accent"></i><i class="block aspect-square size-[3px] rounded-full bg-neutral"></i></span>
                        <span class="flex-1">@themeOption.Label</span>
                        @if (theme == themeOption.Value) { <span class="font-bold text-primary">✓</span> }
                    </button>
                </form>
            }
            </div>
        </div>
    </div>
    <main class="min-h-screen">@RenderBody()</main>
</div>
}
else {
<div class="drawer lg:drawer-open">
    <input id="app-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content min-h-screen">
        <header class="navbar min-h-12 sticky top-0 z-20 border-b border-base-300 bg-base-100/95 px-4 backdrop-blur lg:px-6">
            <label for="app-drawer" class="btn btn-square btn-ghost lg:hidden" aria-label="Menüyü aç">☰</label>
            <div class="flex-1"><span class="text-sm text-base-content/50">BFN DevOps</span><h1 class="font-semibold">@ViewData["Title"]</h1></div>
            <div class="dropdown dropdown-end mr-1">
                <button tabindex="0" class="btn btn-square btn-ghost" aria-label="Tema seç" title="Tema seç">
                    <span class="grid grid-cols-2 gap-[2px] rounded-md border border-base-300 bg-base-100 p-[5px]">
                        <i class="block size-[4px] rounded-full bg-primary"></i><i class="block size-[4px] rounded-full bg-secondary"></i><i class="block size-[4px] rounded-full bg-accent"></i><i class="block size-[4px] rounded-full bg-neutral"></i>
                    </span>
                </button>
                <div tabindex="0" class="dropdown-content z-30 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
                    <div class="px-3 pb-2 pt-1 text-xs font-semibold text-base-content/50">Tema</div>
                    <div class="max-h-96 overflow-y-auto pr-1">
                    @foreach (var themeOption in ThemeCatalog.All) {
                        <form asp-controller="Settings" asp-action="Theme" method="post">
                            <input type="hidden" name="theme" value="@themeOption.Value" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button class="flex w-full items-center gap-3 rounded-md px-3 py-2 text-left text-sm text-base-content hover:bg-base-200">
                                <span data-theme="@themeOption.Value" class="grid aspect-square shrink-0 grid-cols-2 gap-[2px] rounded-md border border-base-300 bg-base-100 p-1"><i class="block aspect-square size-[3px] rounded-full bg-primary"></i><i class="block aspect-square size-[3px] rounded-full bg-secondary"></i><i class="block aspect-square size-[3px] rounded-full bg-accent"></i><i class="block aspect-square size-[3px] rounded-full bg-neutral"></i></span>
                                <span class="flex-1">@themeOption.Label</span>
                                @if (theme == themeOption.Value) { <span class="font-bold text-primary">✓</span> }
                            </button>
                        </form>
                    }
                    </div>
                </div>
            </div>
            <div class="dropdown dropdown-end">
                <button class="btn btn-ghost gap-2"><span class="avatar placeholder"><span class="bg-primary text-primary-content w-8 rounded-full">@User.Identity!.Name![0].ToString().ToUpperInvariant()</span></span><span class="hidden sm:inline">@User.Identity.Name</span></button>
                <ul class="menu dropdown-content z-30 mt-3 w-56 rounded-box bg-base-100 p-2 shadow-xl"><li><a asp-controller="Account" asp-action="ChangePassword">Parolayı değiştir</a></li><li><form asp-controller="Account" asp-action="Logout" method="post"><button class="w-full text-left">Çıkış yap</button></form></li></ul>
            </div>
        </header>
        <main class="p-4 lg:p-6">
            @if (TempData["Message"] is string message) { <div class="alert alert-success mb-5"><span>@message</span></div> }
            @if (TempData["Error"] is string error) { <div class="alert alert-error mb-5"><span>@error</span></div> }
            @RenderBody()
        </main>
    </div>
    <aside class="drawer-side z-40"><label for="app-drawer" class="drawer-overlay"></label>
        <div class="flex min-h-full w-60 flex-col border-r border-base-300 bg-base-100 p-3">
            <a asp-controller="Boards" asp-action="Index" class="mb-3 flex items-center justify-center py-1"><span class="font-brand text-xl font-extrabold tracking-[-.03em]"><span class="text-secondary">b</span>fn<span class="text-primary">ops</span></span></a>
            <ul class="menu flex-1 gap-1 p-0">
                <li class="menu-title">Çalışma alanı</li>
                <li><a asp-controller="Boards" asp-action="Index" class="gap-2 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15M5.25 4.5h13.5A2.25 2.25 0 0121 6.75v10.5a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 17.25V6.75A2.25 2.25 0 015.25 4.5z" /></svg>Panolar</a></li>
                <li><a asp-controller="Projects" asp-action="Index" class="gap-2 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>Projeler</a></li>
                <li><a asp-controller="Sites" asp-action="Index" class="gap-2 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m-15.432 0A8.959 8.959 0 013 12c0-.778.099-1.533.284-2.253" /></svg>IIS Siteleri</a></li>
                <li><a asp-controller="Users" asp-action="Index" class="gap-2 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>Kullanıcılar</a></li>
            </ul>
            <ul class="menu border-t border-base-300 pt-3">
                <li><a asp-controller="Settings" asp-action="Index" class="gap-2 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28zM15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>Ayarlar</a></li>
            </ul>
        </div>
    </aside>
</div> }
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
