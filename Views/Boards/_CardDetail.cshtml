@model BoardCardDetailViewModel
@{ var card = Model.Card; }
<form method="post" asp-controller="Boards" asp-action="UpdateCard">
    <input type="hidden" name="Id" value="@card.Id" />
    <div class="flex items-center justify-between border-b border-base-300 px-5 py-3">
        <select name="BoardColumnId" class="select select-sm select-ghost font-semibold">
            @foreach (var col in Model.Columns) { <option value="@col.Id" selected="@(col.Id == card.BoardColumnId)">@col.Name</option> }
        </select>
        <button type="button" class="btn btn-sm btn-square btn-ghost" onclick="card_detail.close()" aria-label="Kapat">✕</button>
    </div>
    <div class="px-5 py-4">
        <input name="Title" value="@card.Title" class="input input-ghost w-full px-0 text-xl font-bold focus:outline-none" />

        <div class="mt-4 grid grid-cols-[110px_1fr] items-center gap-y-3 text-[13px]">
            <span class="text-base-content/50">Atanan</span>
            <select name="AssignedUserId" class="select select-sm w-full max-w-xs">
                <option value="">— Atanmadı —</option>
                @foreach (var u in Model.Users) { <option value="@u.Id" selected="@(u.Id == card.AssignedUserId)">@u.UserName</option> }
            </select>

            <span class="text-base-content/50">Açan</span>
            <span>@(card.CreatedByUser?.UserName ?? "—")</span>

            <span class="text-base-content/50">Öncelik</span>
            <select name="Priority" class="select select-sm w-full max-w-xs">
                @foreach (var p in Enum.GetValues<CardPriority>()) { <option value="@p" selected="@(p == card.Priority)">@CardPriorityDisplay.Label(p)</option> }
            </select>

            <span class="text-base-content/50">Son tarih</span>
            <input type="date" name="DueAtUtc" value="@(card.DueAtUtc?.ToString("yyyy-MM-dd"))" class="input input-sm w-full max-w-xs" />

            <span class="text-base-content/50">Etiketler</span>
            <input name="Tags" value="@card.Tags" class="input input-sm w-full max-w-xs" placeholder="virgülle ayırın" />
        </div>

        <div class="divider"></div>
        <textarea name="Description" class="textarea w-full min-h-24" placeholder="Açıklama ekleyin…">@card.Description</textarea>

        <div class="mt-3 flex justify-end"><button class="btn btn-primary btn-sm">Kaydet</button></div>
    </div>
</form>
<div class="divider px-5">Yorumlar</div>
<div class="space-y-3 px-5">
    @if (card.Comments.Count == 0) { <p class="text-[13px] text-base-content/50">Henüz yorum yok — ilk notu sen ekle.</p> }
    @foreach (var c in card.Comments) {
        <div class="rounded-md bg-base-200 p-3 text-[13px]">
            <div class="mb-1 flex items-center justify-between text-xs text-base-content/50">
                <span class="font-semibold text-base-content/70">@(c.Author?.UserName ?? "Silinmiş kullanıcı")</span>
                <span>@c.CreDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            </div>
            <p class="whitespace-pre-wrap">@c.Body</p>
        </div>
    }
</div>
<form method="post" asp-controller="Boards" asp-action="AddComment" class="px-5 py-4">
    <input type="hidden" name="BoardCardId" value="@card.Id" />
    <textarea name="Body" required class="textarea min-h-16 w-full" placeholder="Yorum yazın…"></textarea>
    <div class="mt-2 flex justify-end"><button class="btn btn-sm btn-primary">Yorum ekle</button></div>
</form>
