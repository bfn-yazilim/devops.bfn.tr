@model ApplicationUser
@{ ViewData["Title"] = "Ayarlar"; }
<div class="mb-6 grid gap-4 md:grid-cols-2"><a asp-controller="Projects" asp-action="Index" class="card border border-base-300 bg-base-100 shadow-sm transition hover:border-primary"><div class="card-body"><h2 class="card-title">◆ Projeler</h2><p class="text-base-content/60">Proje, IIS ve güncelleme adımlarını yapılandırın.</p></div></a><a asp-controller="Users" asp-action="Index" class="card border border-base-300 bg-base-100 shadow-sm transition hover:border-primary"><div class="card-body"><h2 class="card-title">♙ Kullanıcılar</h2><p class="text-base-content/60">Hesapları ve yönetici erişimini yönetin.</p></div></a></div>
<div class="grid gap-6 lg:grid-cols-2"><div class="card bg-base-100 shadow-sm"><div class="card-body"><h2 class="card-title">Görünüm</h2><p class="text-base-content/60">Tema tercihiniz hesabınıza kaydedilir.</p><div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
@foreach(var theme in new[]{("bfnorbi","BFN Orbi"),("bfnlight","BFN Açık"),("bfndark","BFN Koyu"),("corporate","Corporate"),("business","Business"),("night","Night")}){<form asp-action="Theme" method="post"><input name="theme" value="@theme.Item1" type="hidden"/><button class="btn w-full @(Model.Theme==theme.Item1 ? "btn-primary" : "btn-outline")">@theme.Item2</button></form>}
</div></div></div><div class="card bg-base-100 shadow-sm"><div class="card-body"><h2 class="card-title">Hesap güvenliği</h2><p class="text-base-content/60">Kurucu hesap başka kullanıcılar tarafından silinemez veya değiştirilemez.</p><div class="mt-4"><div class="font-medium">@Model.UserName</div>@if(Model.IsFounder){<span class="badge badge-neutral mt-1">Kurucu kullanıcı</span>}</div><div class="card-actions mt-4"><a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline">Parolayı değiştir</a></div></div></div></div>
