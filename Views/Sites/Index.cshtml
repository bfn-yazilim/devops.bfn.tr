@model IReadOnlyList<IisSiteInfo>
@{ ViewData["Title"] = "IIS Siteleri"; }
<div class="mb-6 flex items-center justify-between"><div><h2 class="text-2xl font-bold">IIS Siteleri</h2><p class="text-base-content/60">Sunucudaki canlı IIS yapılandırması</p></div><a asp-action="Create" class="btn btn-primary">+ Yeni site</a></div>
@if(ViewBag.IisError is not null){<div class="alert alert-warning mb-5"><span><strong>IIS okunamadı:</strong> @ViewBag.IisError<br/><small>Uygulamayı IIS yönetim yetkisi bulunan bir hesapla çalıştırın.</small></span></div>}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">@foreach(var site in Model){<div class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body"><div class="flex justify-between"><h3 class="card-title">@site.Name</h3><span class="badge badge-outline">@site.State</span></div><p class="truncate text-sm text-base-content/60" title="@site.PhysicalPath">@site.PhysicalPath</p><div class="mt-2 space-y-1">@foreach(var binding in site.Bindings){<code class="block rounded bg-base-200 px-2 py-1 text-xs">@binding</code>}</div></div></div>}</div>
