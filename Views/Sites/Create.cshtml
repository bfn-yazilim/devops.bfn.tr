@model CreateSiteViewModel
@{ ViewData["Title"] = "Yeni IIS Sitesi"; }
<div class="mx-auto max-w-xl">
    <form method="post" class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title">Yeni IIS sitesi</h2>
            <p class="text-base-content/60">Site dizini IIS kökü altında oluşturulur.</p>
            <div asp-validation-summary="ModelOnly"></div>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Site adı</legend>
                <input asp-for="Name" class="input w-full" />
            </fieldset>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Port</legend>
                <input asp-for="Port" class="input w-full" />
            </fieldset>
            <fieldset class="fieldset">
                <legend class="fieldset-legend">Host adı</legend>
                <input asp-for="HostName" class="input w-full" placeholder="ornek.bfn.tr" />
            </fieldset>
            <div class="card-actions justify-end pt-2">
                <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
                <button class="btn btn-primary">Siteyi oluştur</button>
            </div>
        </div>
    </form>
</div>
